# PetOps 单门店部署环境变量模板。
# 用法：cp .env.template .env，按需填写后 docker compose up -d --build。
# 注意：.env 含密钥，切勿提交到版本库。

# ---- 运行环境 ----
PETOPS_ENVIRONMENT=prod
PETOPS_DEBUG=false
UVICORN_WORKERS=1

# ---- 单门店默认租户（留空则回退企业微信 corp_id，须与种子数据一致）----
# 单店自建应用场景下运行时租户 == corp_id；如需自定义租户键在此设置。
PETOPS_DEFAULT_TENANT_ID=
# 首次启动是否写入演示客户+宠物（1 开启），并可绑定测试者的企业微信 external_user_id：
PETOPS_SEED_DEMO=0
PETOPS_SEED_DEMO_EXTERNAL_ID=

# ---- PostgreSQL（host 由 compose 注入为 db，无需改）----
PETOPS_DB_USER=petops
PETOPS_DB_PASSWORD=Poke!950119
PETOPS_DB_NAME=petops
PETOPS_DB_PORT=5432

# ---- Redis（host 由 compose 注入为 redis）----
PETOPS_REDIS_PORT=6379
# PETOPS_REDIS_PASSWORD=

# ---- 云端 LLM（通义千问 / 智谱 GLM / MiniMax）----
# 重要：base_url 必须是 OpenAI 兼容基址（以 /v1 结尾），本服务调用 /chat/completions。
#   - MiniMax（国内）：https://api.minimaxi.com/v1
#   - MiniMax（海外）：https://api.minimax.io/v1
#   - 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 智谱 GLM：https://open.bigmodel.cn/api/paas/v4
# 切勿使用 /anthropic 路由（那是 Anthropic 兼容接口，本服务不适配）。
PETOPS_LLM_PROVIDER=minimax
PETOPS_LLM_API_KEY=sk-cp-LHXcQGoAqnAb8vUG_0VMPwnEf5ZHXFF7nXfdgNoih-VOvd1oRRdiTeiXJjC22hP_OE_xXyQkL54WDaEUxrhzBe4NA46Esux7nG8MkLTu1ExDLGTQ54bQ6FU
PETOPS_LLM_BASE_URL=https://api.minimaxi.com/v1
PETOPS_LLM_MODEL=MiniMax-M3
PETOPS_LLM_TIMEOUT_SECONDS=10
PETOPS_LLM_MAX_RETRIES=3

# ---- 第三方视觉检测（宠智灵 / 百目魔君）----
PETOPS_VISION_PROVIDER=chongzhiling
PETOPS_VISION_API_KEY=your-vision-api-key
PETOPS_VISION_BASE_URL=https://api.example-vision.com/v1

