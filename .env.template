# PetOps 单门店部署环境变量模板。
# 用法：cp .env.template .env，按需填写后 docker compose up -d --build。
# 注意：.env 含密钥，切勿提交到版本库。

# ---- 运行环境 ----
PETOPS_ENVIRONMENT=prod
PETOPS_DEBUG=false
UVICORN_WORKERS=1

# ---- PostgreSQL（host 由 compose 注入为 db，无需改）----
PETOPS_DB_USER=petops
PETOPS_DB_PASSWORD=Poke!950119
PETOPS_DB_NAME=petops
PETOPS_DB_PORT=5432

# ---- Redis（host 由 compose 注入为 redis）----
PETOPS_REDIS_PORT=6379
# PETOPS_REDIS_PASSWORD=

# ---- 云端 LLM（通义千问 / 智谱 GLM，二选一）----
PETOPS_LLM_PROVIDER=minimax
PETOPS_LLM_API_KEY=sk-cp-LHXcQGoAqnAb8vUG_0VMPwnEf5ZHXFF7nXfdgNoih-VOvd1oRRdiTeiXJjC22hP_OE_xXyQkL54WDaEUxrhzBe4NA46Esux7nG8MkLTu1ExDLGTQ54bQ6FU
PETOPS_LLM_BASE_URL=https://api.minimaxi.com/anthropic
PETOPS_LLM_MODEL=MiniMax-M3
PETOPS_LLM_TIMEOUT_SECONDS=10
PETOPS_LLM_MAX_RETRIES=3

